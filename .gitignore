# Go runner
/onlytty
/dist/
*.test
*.out

# Elixir relay (portal/)
portal/_build/
portal/deps/
portal/*.ez
portal/onlytty-*.tar
erl_crash.dump

# Terraform (infra/) — keep .terraform.lock.hcl committed; ignore state + secrets
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/crash*.log

# Self-host bundle: the example ships; a real .env holds SECRET_KEY_BASE — never commit it
selfhost/.env

# Node test deps
node_modules/

# OS / editor
.DS_Store
*.swp

# coop working state (commit knowledge, ignore state)
**/.agent/*
!**/.agent/kb/
!**/.agent/skills/
!**/.agent/presets/
!**/.agent/claude/
!**/.agent/loop.yaml
!**/.agent/compose.yml
!**/.agent/Dockerfile
!**/.agent/Dockerfile.dockerignore
!.agent/project.yaml
# the queue is local state, but its layout doc is a BOOT entry point — commit just that
!**/.agent/tasks/
**/.agent/tasks/*
!**/.agent/tasks/README.md

# preset native subagents coop generates in the box (coop-<role>) — never committed
.claude/agents/coop-*.md

# .gemini may be globally ignored (local Gemini state); keep just the skills symlink
!.gemini/
.gemini/*
!.gemini/skills

# Per-agent tool dirs are local only — not published. The shared, public agent
# layer is AGENTS.md, the CLAUDE.md/GEMINI.md symlinks to it, and the committed
# .agent/ knowledge (kb/, skills/). `coop init` regenerates each agent's dir and
# skills link on disk. Kept LAST so it overrides coop's `!.gemini/skills` above.
.claude/
.codex/
.gemini/
